# 统一换行符，避免 Windows/Linux 协作时出现整文件 diff
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
*.woff2 binary
*.aab binary
*.apk binary

# 生成的 shell wrapper 保持 LF，否则 WSL/macOS 下无法执行
kotlin text eol=lf
scripts/*.sh text eol=lf
